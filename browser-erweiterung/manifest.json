{
  "manifest_version": 3,
  "key": "",
  "name": "Studien-Hub Sync (TUWEL und TISS)",
  "version": "0.5.1",
  "description": "Lädt deine TUWEL-Unterlagen, Prüfungstermine und deinen STEOP-Status aus TISS mit deiner Browser-Anmeldung in den lokalen Studien-Hub.",
  "permissions": [
    "storage",
    "alarms",
    "cookies"
  ],
  "host_permissions": [
    "https://tuwel.tuwien.ac.at/*",
    "https://tiss.tuwien.ac.at/*",
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*"
  ],
  "background": {
    "service_worker": "background.js",
    "scripts": [
      "background.js"
    ],
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://tiss.tuwien.ac.at/*"
      ],
      "js": [
        "tiss-inhalt.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Studien-Hub Sync",
    "default_popup": "popup.html"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "tuwel-sync@studien-hub.local",
      "strict_min_version": "121.0"
    }
  }
}
