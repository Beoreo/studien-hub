# Vorlage: nach .env kopieren und ausfüllen. Die .env ist in .gitignore und landet nie in Git.

# Persönlicher TUWEL-Token (TUWEL -> Profil -> Einstellungen -> Sicherheitsschlüssel)
TUWEL_TOKEN=

# Nur ändern, falls sich die Adresse ändert
TUWEL_URL=https://tuwel.tuwien.ac.at

# MB Cloud der Fachschaft (https://mbcloud.at) – am einfachsten im Hub unter „MB Cloud“ → „Verbinden“ eintragen
# lassen; sonst in der MB Cloud unter Einstellungen → Sicherheit ein App-Passwort anlegen.
MBCLOUD_URL=
MBCLOUD_BENUTZER=
MBCLOUD_APP_PASSWORT=
